# Copy to .env.local for development. Real values live in Vercel env vars —
# never commit a filled-in copy of this file.

# Supabase — Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Bypasses RLS; used by the generator to write editions and read
# announcements. Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Any long random string. Vercel Cron sends it as `Authorization: Bearer ...`;
# /api/generate refuses to run when it is unset.
CRON_SECRET=generate-with-openssl-rand-hex-32
